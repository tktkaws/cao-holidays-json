---
import '../styles/global.css';
import HolidayJson from '../components/HolidayJson.astro';
import snapshot from '../data/holidays.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fetchedAt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Tokyo' }).format(new Date(snapshot.metadata.fetchedAt));
const years = snapshot.metadata.years;
const latestYear = years.at(-1)!;
const initialHolidays = Object.fromEntries(
  Object.entries(snapshot.holidays).filter(([date]) => date.startsWith(`${latestYear}-`)),
);
const initialApiPath = `${base}/api/v1/${latestYear}/date.json`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="内閣府の祝日・休日データをJSONで取得できるAPIです。" />
    <title>内閣府「国民の祝日」JSON</title>
  </head>
  <body class="min-h-screen bg-white font-sans text-base leading-relaxed text-black [color-scheme:light]">
    <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-16">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">内閣府「国民の祝日」JSON</h1>
      <p class="mt-5 text-lg leading-8 text-black sm:text-xl">内閣府の祝日・休日データをJSONで取得できます。</p>
      <section class="mt-10 min-w-0" aria-labelledby="format-title">
        <h2 id="format-title" class="text-xl font-bold sm:text-2xl">日付と名称のシンプルなJSON</h2>
        <div class="mt-3 text-sm leading-7 text-black">
          <p>このJSONは、日本の祝日・休日を日付と名称の組み合わせで収録したデータです。</p>
          <p>日付は「2026-01-01」のような「年-月-日」形式のキー、名称は「元日」のような文字列の値で表します。</p>
        </div>
      </section>
      <section class="mt-6 min-w-0" aria-labelledby="source-title">
        <h2 id="source-title" class="text-xl font-bold sm:text-2xl">内閣府のCSVから生成</h2>
        <div class="mt-3 text-sm leading-7 text-black">
          <p>本APIは、内閣府が公開する祝日・休日のCSVを取得し、JSON形式に変換しています。</p>
          <p>振替休日なども内閣府の名称で収録しており、土曜日や日曜日をすべて含む一覧ではありません。</p>
        </div>
      </section>
      <section class="mt-6 min-w-0" aria-labelledby="update-title">
        <h2 id="update-title" class="text-xl font-bold sm:text-2xl">データの自動更新</h2>
        <div class="mt-3 text-sm leading-7 text-black">
          <p>毎年10月29日16時（日本時間）に、内閣府のCSVを取得する定期処理を設定しています。</p>
          <p>取得したデータの形式や翌年の祝日の収録を検証し、更新候補を自動で作成します。</p>
          <p>公開中のAPIには、更新内容の確認・マージと、ビルド・公開を行った後に反映されます。</p>
          <p>実際のデータ取得日時は、下の「データについて」で確認できます。</p>
        </div>
      </section>
      <section class="py-10 sm:py-14" aria-labelledby="explorer-title">
        <h2 id="explorer-title" class="text-xl font-bold sm:text-2xl">祝日データを確認</h2>
        <p class="mt-2 text-sm leading-7 text-black">期間を選ぶと、APIから取得したJSONを表示します。</p>
        <div class="mt-6 flex flex-col gap-5 rounded-xl bg-[#f6f6f7] p-6 sm:flex-row sm:items-end sm:gap-8">
          <div class="grid gap-2">
            <label for="year" class="text-sm font-medium">取得する期間</label>
            <select id="year" class="min-h-11 w-full min-w-40 rounded-lg border border-[#dedee3] bg-white px-3 py-2 text-base text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black sm:w-40">
              <option value="">全期間</option>
              {[...years].reverse().map(year => <option value={year} selected={year === latestYear}>{year}年</option>)}
            </select>
          </div>
          <div class="grid min-w-0 gap-2">
            <span class="text-sm font-medium">API URL</span>
            <a id="api-url" class="flex min-w-0 items-center gap-1 py-2 font-mono text-sm text-black underline underline-offset-4 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black" href={initialApiPath} target="_blank" rel="noopener noreferrer" aria-label="API URL（別ウィンドウで開きます）">
              <span id="api-url-text" class="min-w-0 break-all">{initialApiPath}</span>
              <svg class="size-3.5 shrink-0 translate-y-[0.1em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M14 3h7v7M21 3 10 14" />
                <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" />
              </svg>
            </a>
          </div>
        </div>
        <div class="mt-4 min-w-0 overflow-hidden rounded-xl border border-[#e7e7e9] bg-[#fafafa] text-black">
          <div class="flex items-center justify-between gap-4 border-b border-[#e7e7e9] px-4 py-3 text-sm sm:px-5">
            <span>JSON</span>
            <span id="status" role="status" aria-live="polite">{Object.keys(initialHolidays).length.toLocaleString()}件</span>
          </div>
          <div id="result"><HolidayJson holidays={initialHolidays} /></div>
        </div>
        <noscript>期間の切り替えにはJavaScriptを有効にしてください。上のAPI URLから直接取得することもできます。</noscript>
      </section>
      <section aria-labelledby="data-title">
        <h2 id="data-title" class="text-xl font-bold sm:text-2xl">データについて</h2>
        <dl class="mt-6 divide-y divide-[#e7e7e9] border-y border-[#e7e7e9] text-left text-sm leading-7">
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <dt class="font-semibold">収録期間</dt>
            <dd>{years[0]}年 — {years.at(-1)}年</dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <dt class="font-semibold">収録件数</dt>
            <dd>{snapshot.metadata.count.toLocaleString()}件</dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <dt class="font-semibold">データ取得日時</dt>
            <dd>{fetchedAt}（日本時間）</dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <dt class="font-semibold">元データ</dt>
            <dd class="min-w-0">
              <a class="inline-flex max-w-full items-center gap-1 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black" href={snapshot.metadata.source} target="_blank" rel="noopener noreferrer">
                <span class="min-w-0 break-all">{snapshot.metadata.source}</span>
                <svg class="size-3.5 shrink-0 translate-y-[0.1em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M14 3h7v7M21 3 10 14" />
                  <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" />
                </svg>
                <span class="sr-only">（内閣府の祝日・休日CSV、別ウィンドウで開きます）</span>
              </a>
            </dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <dt class="font-semibold">出典</dt>
            <dd class="min-w-0">
              <a class="inline-flex max-w-full items-center gap-1 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black" href="https://www8.cao.go.jp/chosei/shukujitsu/gaiyou.html" target="_blank" rel="noopener noreferrer">
                <span class="min-w-0">内閣府「国民の祝日」について</span>
                <svg class="size-3.5 shrink-0 translate-y-[0.1em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M14 3h7v7M21 3 10 14" />
                  <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" />
                </svg>
                <span class="sr-only">（別ウィンドウで開きます）</span>
              </a>
            </dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <dt class="font-semibold">リポジトリ</dt>
            <dd class="min-w-0">
              <a class="break-all underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black" href="https://github.com/tktkaws/cao-holidays-json" target="_blank" rel="noopener noreferrer">https://github.com/tktkaws/cao-holidays-json<span class="sr-only">（別ウィンドウで開きます）</span></a>
            </dd>
          </div>
        </dl>
      </section>
    </main>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#year')!;
      const link = document.querySelector<HTMLAnchorElement>('#api-url')!;
      const linkText = document.querySelector<HTMLElement>('#api-url-text')!;
      linkText.textContent = link.href;
      const result = document.querySelector<HTMLElement>('#result')!;
      const status = document.querySelector<HTMLElement>('#status')!;
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      // Keep the same accessible, Tailwind-styled container when a preview is unavailable.
      const plainPreview = result.querySelector('pre')!.cloneNode(false) as HTMLPreElement;
      function showPlain(text: string) {
        const pre = plainPreview.cloneNode(false) as HTMLPreElement;
        const code = document.createElement('code');
        code.textContent = text;
        pre.append(code);
        result.replaceChildren(pre);
      }
      let request = 0;
      async function load() {
        const current = ++request;
        const year = select.value;
        const path = `${base}/api/v1/${year ? `${year}/` : ''}date.json`;
        link.href = path;
        linkText.textContent = link.href;
        status.textContent = '読み込み中…';
        result.textContent = '';
        try {
          const response = await fetch(path);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (current !== request) return;
          const json = JSON.stringify(data, null, 2);
          showPlain(json);
          status.textContent = `${Object.keys(data).length.toLocaleString()}件`;
          try {
            const preview = await fetch(`${base}/json-preview/${year || 'all'}/`);
            if (!preview.ok) throw new Error(`HTTP ${preview.status}`);
            const document = new DOMParser().parseFromString(await preview.text(), 'text/html');
            if (current !== request) return;
            const pre = document.querySelector('pre.astro-code');
            // If cached HTML and API data differ, retain the current API response.
            if (pre?.querySelector('code')?.textContent === json) result.replaceChildren(pre);
          } catch {
            // JSON remains readable even if the highlighted preview cannot be loaded.
          }
        } catch (error) {
          if (current !== request) return;
          status.textContent = '取得に失敗しました';
          showPlain(`データを読み込めませんでした。${error instanceof Error ? error.message : ''}`);
        }
      }
      select.addEventListener('change', load);
    </script>
  </body>
</html>
