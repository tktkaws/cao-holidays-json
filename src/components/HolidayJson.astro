---
import { Code } from 'astro:components';

interface Props {
  holidays: Record<string, string>;
}

const { holidays } = Astro.props;
---

<Code
  code={JSON.stringify(holidays, null, 2)}
  lang="json"
  theme="material-theme-lighter"
  wrap={null}
  class="max-h-[45rem] overflow-auto p-4 font-mono text-sm leading-7 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-black sm:p-5"
  tabindex="0"
  aria-label="祝日データのJSON"
/>
